# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local:  postgresql://postgres@127.0.0.1:5432/splitwise?schema=public
# Neon / Supabase / Vercel Postgres: paste the pooled connection string.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/splitwise?schema=public"

# Random secret used to sign session cookies. Generate one with:
#   npx auth secret        (or)   openssl rand -base64 32
AUTH_SECRET=""

# The public URL of this app. Locally that's http://localhost:3000;
# in production use the real origin, e.g. https://split.karanmittal.com
AUTH_URL="http://localhost:3000"

# Google OAuth credentials — see the README for the five-minute walkthrough.
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to "true" to show the local email-only sign-in box on /login. It is
# ignored entirely in production builds, so it can never become a back door.
ALLOW_DEV_LOGIN="true"

# Email delivery for invites (optional — every invite also produces a link you
# can send yourself). Free tier: https://resend.com
RESEND_API_KEY=""
RESEND_FROM="Splitwise Killer <invites@yourdomain.com>"

# Dialling code applied to mobile numbers typed without one, so "9876543210"
# and "+91 98765 43210" are recognised as the same person. Default: 91 (India).
DEFAULT_COUNTRY_CODE="91"

# Only needed if the public URL differs from AUTH_URL (e.g. behind a proxy).
# NEXT_PUBLIC_APP_URL="https://split.karanmittal.com"
